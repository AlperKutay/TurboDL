{
  "name": "@turbodl/desktop",
  "productName": "TurboDL",
  "version": "0.8.0",
  "private": true,
  "description": "TurboDL download manager",
  "author": "TurboDL",
  "license": "MIT",
  "homepage": "https://github.com/AlperKutay/TurboDL",
  "desktopName": "turbodl-app.desktop",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/build-cli.mjs",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "e2e": "electron-vite build && node scripts/build-cli.mjs && playwright test",
    "dist": "electron-builder --config electron-builder.config.cjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@turbodl/shared": "workspace:*",
    "@types/chrome": "0.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.28.2",
    "fast-xml-parser": "5.11.1",
    "ffmpeg-static": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
